# Django Application Settings
DJANGO_SECRET_KEY="replace-with-a-secure-random-secret-key-for-production"
DJANGO_DEBUG=True
ALLOWED_HOSTS="localhost,127.0.0.1"

# Meta Model API (accessed via OpenAI Python SDK)
# Note: Key contains pipe ('|') characters and MUST be enclosed in double quotes.
MODEL_API_KEY="LLM|your_numeric_id|your_secret"
META_BASE_URL="https://api.meta.ai/v1"
META_MODEL="muse-spark-1.3"

# Mode: 'mock' (default for testing/offline) or 'live' (for real API calls)
META_MODE="mock"
META_TIMEOUT_SECONDS=30.0

# Text parser reasoning effort: empty for default, or "minimal", "low"
META_REASONING_EFFORT=""
MAX_INPUT_TEXT_LENGTH=500

# Vision photo parsing settings (independent of META_REASONING_EFFORT)
# Leave empty for model default, or "minimal", "low"
META_VISION_REASONING_EFFORT=""
META_VISION_TIMEOUT_SECONDS=90.0

# Kadai Khata Ledger Settings
MAX_ENTRY_AMOUNT=100000.00
